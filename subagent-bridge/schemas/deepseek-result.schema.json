{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "summary",
    "findings",
    "proposed_steps",
    "risks",
    "questions",
    "requires_human_approval"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["completed", "needs_context", "blocked", "failed"]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 30000
    },
    "findings": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "evidence", "impact", "recommendation", "confidence"],
        "properties": {
          "title": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "evidence": { "type": "string", "minLength": 1, "maxLength": 12000 },
          "impact": { "type": "string", "minLength": 1, "maxLength": 12000 },
          "recommendation": { "type": "string", "minLength": 1, "maxLength": 12000 },
          "confidence": {
            "type": "string",
            "enum": ["high", "medium", "low"]
          }
        }
      }
    },
    "proposed_steps": {
      "type": "array",
      "maxItems": 100,
      "items": { "type": "string", "minLength": 1, "maxLength": 4000 }
    },
    "risks": {
      "type": "array",
      "maxItems": 100,
      "items": { "type": "string", "minLength": 1, "maxLength": 4000 }
    },
    "questions": {
      "type": "array",
      "maxItems": 100,
      "items": { "type": "string", "minLength": 1, "maxLength": 4000 }
    },
    "requires_human_approval": {
      "type": "boolean"
    }
  }
}
